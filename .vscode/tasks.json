{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start PawHome (Full Stack: Server + Client)",
      "dependsOn": ["Start Backend Server", "Start Frontend Client"],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Start Backend Server",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/pawhomemain/server"
      },
      "isBackground": true,
      "problemMatcher": ["$tsc-watch"]
    },
    {
      "label": "Start Frontend Client",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/pawhomemain/client"
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
